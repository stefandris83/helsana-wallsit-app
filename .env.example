# Beispielwerte fuer die lokale Entwicklung. Kopieren nach `.env.local`.
# Diese Datei enthaelt bewusst keine echten Secrets.

# Zugangscode fuer den Admin-Bereich (/admin).
# ACHTUNG: Das ist KEIN produktiver Authentisierungsmechanismus (siehe README, Abschnitt «Pilot-Dashboard»).
VITE_ADMIN_CODE=pilot-admin-demo

# Quelle des Anleitungsvideos (§17, B.13.4). Leer lassen => klar gekennzeichneter Platzhalter.
VITE_INSTRUCTION_VIDEO_URL=
# Optionale Untertitelspur (WebVTT) zum Video.
VITE_INSTRUCTION_VIDEO_TRACK_URL=

# Feature-Flag «Pause ueberspringen» (B.13.5). Standard: deaktiviert, freigabepflichtig.
VITE_FEATURE_SKIP_REST=false

# Mindestgruppengroesse fuer aggregierte Dashboard-Werte (B.13.7).
VITE_MIN_GROUP_SIZE=5
